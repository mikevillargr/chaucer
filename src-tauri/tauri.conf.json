{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chaucer",
  "version": "1.4.0",
  "identifier": "com.mikevillargr.chaucer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3010",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chaucer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.productivity",
    "shortDescription": "A desktop client for Gmail",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2NUI0MDg2MTg5MkJDQ0EKUldUS3ZKSVloa0JicHNoQnFGNUZVUGF6eDRZUmlJcFlXNGxQL1g2MngxNjhIb1QxcmMzNGVPckQK",
      "endpoints": [
        "https://github.com/mikevillargr/chaucer/releases/latest/download/latest.json"
      ]
    }
  }
}
